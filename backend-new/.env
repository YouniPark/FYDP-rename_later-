# Backend - EEG Test

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG

# ── Face Recognition ──────────────────────────────────────────────────────────
FACE_RECOGNIZER_BACKEND=arcface
ARCFACE_MODEL_NAME=buffalo_l
ARCFACE_SIMILARITY_THRESHOLD=0.5

# ── Cue delivery ──────────────────────────────────────────────────────────────
USE_LOCAL_CUES=true
USE_URL=false
OVERRIDE_SEND_CUE_FOR_KNOWN_FACES=true # Change to true for in-person testing

# ── Face memory / temporal voting ─────────────────────────────────────────────
# Inference rate
INFERENCE_SAMPLE_FPS=5
# How long (seconds) to accumulate face detections before voting on identity.
MEMORY_WINDOW_SECONDS=1.0
MEMORY_MIN_VOTES=2
MEMORY_MAJORITY_RATIO=0.6

## EEG Settings
EEG_AMP_THRESH_UV=1000.0
IGNORE_TRIAL_REJECTION=false
UNFAMILIAR_IF_NO_EEG=true